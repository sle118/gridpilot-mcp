# Copy this file to `.env` for local development credentials.
# Fill in only the values you need for your workflow.
# Never commit the populated `.env` file.

# Local GitLab instance used during development.
# Replace with the base URL for your local GitLab host.
# Example: GITLAB_HOST=http://gitlab.local
GITLAB_HOST=

# Repository URL for this project on the local GitLab instance.
# Replace with the clone or push URL for this repository.
# Example: GITLAB_REPOSITORY_URL=http://gitlab.local/your-group/your-repo.git
GITLAB_REPOSITORY_URL=

# Personal access token for the local GitLab instance.
# Replace with a token that has the scopes your workflow requires.
# Example: GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
GITLAB_TOKEN=

# Optional GitLab username for HTTPS auth flows or helper scripts.
# Example: GITLAB_USERNAME=your-gitlab-username
GITLAB_USERNAME=

# GitHub personal access token for github.com operations.
# Replace with a token that has the minimum scopes you need.
# Example: GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx
GITHUB_TOKEN=

# Optional GitHub username for HTTPS auth flows or helper scripts.
# Example: GITHUB_USERNAME=your-github-username
GITHUB_USERNAME=

# Optional github.com repository URL if this repo is mirrored or published there.
# Example: GITHUB_REPOSITORY_URL=https://github.com/your-org/gridpilot-mcp.git
GITHUB_REPOSITORY_URL=
